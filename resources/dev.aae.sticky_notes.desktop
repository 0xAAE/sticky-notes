[Desktop Entry]
Name=Sticky Notes
Comment=Implementation of sticky notes for Cosmic desktop environment
Type=Application
Icon=dev.aae.sticky_notes
Exec=notes-applet %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
